{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drift Codex judgment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "overview", "summary", "rerun", "incidents", "gaps"],
  "properties": {
    "schema": {"type": "string", "const": "drift.judgment/v1"},
    "overview": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": ".*\\S.*"},
    "summary": {"$ref": "#/$defs/summary"},
    "rerun": {"$ref": "#/$defs/rerun"},
    "incidents": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/incident"}},
    "gaps": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/prose"}}
  },
  "$defs": {
    "prose": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": ".*\\S.*"},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\uFEFF]*[^\\s\\u0000-\\u001F\\u007F-\\u009F\\uFEFF][^\\u0000-\\u001F\\u007F-\\u009F\\uFEFF]*$"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_outcome",
        "outcome_reason",
        "outcome_evidence",
        "trajectory",
        "trajectory_reason",
        "confidence"
      ],
      "properties": {
        "task_outcome": {
          "type": "string",
          "enum": ["trace_supported_success", "claimed_success", "partial", "failure", "unknown"]
        },
        "outcome_reason": {"$ref": "#/$defs/prose"},
        "outcome_evidence": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/event_id"}},
        "trajectory": {
          "type": "string",
          "enum": ["clean", "recovered_detour", "unrecovered_detour", "derailed", "unknown"]
        },
        "trajectory_reason": {"$ref": "#/$defs/prose"},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
      }
    },
    "rerun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "reason", "prerequisites", "inspect", "follow_up"],
      "properties": {
        "recommendation": {"type": "string", "enum": ["keep", "rerun", "inspect", "unknown"]},
        "reason": {"$ref": "#/$defs/prose"},
        "prerequisites": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/prose"}},
        "inspect": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/prose"}},
        "follow_up": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/prose"}}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onset", "detected", "recovery_started", "recovery_confirmed"],
      "properties": {
        "onset": {"type": ["string", "null"], "maxLength": 256},
        "detected": {"type": ["string", "null"], "maxLength": 256},
        "recovery_started": {"type": ["string", "null"], "maxLength": 256},
        "recovery_confirmed": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "basis", "supports", "excerpt"],
      "properties": {
        "event_id": {"$ref": "#/$defs/event_id"},
        "basis": {
          "type": "string",
          "enum": [
            "agent_action",
            "tool_observation",
            "state_observation",
            "task_update_observation",
            "outcome_observation",
            "agent_report",
            "user_report",
            "inference"
          ]
        },
        "supports": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": ".*\\S.*"},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "task_relation",
        "cause",
        "severity",
        "status",
        "task_effect",
        "lifecycle",
        "affected_events",
        "evidence",
        "causal_unknowns",
        "unknowns",
        "rerun_relevance"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\uFEFF]*[^\\s\\u0000-\\u001F\\u007F-\\u009F\\uFEFF][^\\u0000-\\u001F\\u007F-\\u009F\\uFEFF]*$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": ".*\\S.*"},
        "category": {
          "type": "string",
          "enum": [
            "context_state",
            "scope",
            "wrong_objective",
            "unrelated_work",
            "tool_execution",
            "loop_churn",
            "coordination",
            "constraint_or_safety",
            "other"
          ]
        },
        "task_relation": {
          "type": "string",
          "enum": [
            "incidental_detour",
            "intrinsic_troubleshooting",
            "legitimate_exploration",
            "external_friction",
            "unknown"
          ]
        },
        "cause": {
          "type": "string",
          "enum": ["agent", "environment", "tool", "user", "external", "inherited", "unknown"]
        },
        "severity": {"type": "string", "enum": ["low", "medium", "high", "critical", "unknown"]},
        "status": {
          "type": "string",
          "enum": [
            "reported",
            "detected",
            "recovery_intended",
            "recovering",
            "recovered",
            "completed",
            "unrecovered",
            "unknown"
          ]
        },
        "task_effect": {
          "type": "string",
          "enum": ["delay", "rework", "state_risk", "artifact_risk", "outcome_risk", "none", "unknown"]
        },
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "affected_events": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/event_id"}},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}},
        "causal_unknowns": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/prose"}},
        "unknowns": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/prose"}},
        "rerun_relevance": {"$ref": "#/$defs/prose"}
      }
    }
  }
}
